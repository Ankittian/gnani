# Copy to .env.local and fill in. Never commit .env.local.

# Gnani (app.gnani.ai/voice → API keys). Sent as X-API-Key-ID header.
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai

# Google Gemini (aistudio.google.com → API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# 1 = serve recorded fixtures instead of calling Gnani/Gemini (saves credits during UI work)
MOCK_MODE=0

# Per-IP daily caps on the public demo, to protect the 5,000 Gnani credits
DAILY_STT_CAP_PER_IP=80
DAILY_TTS_CAP_PER_IP=120
